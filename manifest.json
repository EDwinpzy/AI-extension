{
  "manifest_version": 3,
  "name": "AI-extension",
  "description": "ChatGPT 补丁的设置页：翻译、字幕、暗黑模式等设置，独立插件。",
  "version": "1.0.8",
  "default_locale": "zh_CN",
  "background": {
    "service_worker": "background-loader.js"
  },
  "options_ui": {
    "page": "translate/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AI-extension",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_popup": "launch.html"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "notifications",
    "clipboardWrite",
    "scripting",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "translate/content.js",
        "translate/subtitle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-darkling": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "切换当前页面的暗黑模式"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}